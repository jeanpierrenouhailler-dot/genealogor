rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles collection
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidId(userId)
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner(userId);
    }

    // Family trees collection
    match /trees/{treeId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(treeId)
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(treeId)
        && (resource.data.ownerId == request.auth.uid || request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isSignedIn() && isValidId(treeId)
        && resource.data.ownerId == request.auth.uid;

      // Archives subcollection under tree
      match /archives/{archiveId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(archiveId);
        allow delete: if isSignedIn() && isValidId(archiveId);
      }

      // Branch access rules subcollection
      match /access/{accessId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isSignedIn() && isValidId(accessId);
      }
    }
  }
}
